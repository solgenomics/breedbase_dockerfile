services:
  breedbase:
    volumes:
      - webdata:/home/production/volume
    ports:
      - 8080:8080
    image: breedbase/breedbase:latest
    depends_on:
      - breedbase_db
    container_name: breedbase_web

  breedbase_db:
    volumes:
      - dbdata18:/var/lib/postgresql
    image: postgres:18
    container_name: breedbase_db
    healthcheck:
      test: "pg_isready -U postgres -d $${POSTGRES_DB} || exit 1"
      interval: 10s

